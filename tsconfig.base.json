// Shared compiler options for every package's tsconfig.src.json (the code
// that runs in the browser). Each package extends this and sets its own
// `include`. vite.config.ts files use tsconfig.node.base.json instead.
{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2025", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    // resolve workspace packages (@mrkev/*) to their source, not their dist/.
    // See the "mrkev:source" entry in each package's package.json exports.
    "customConditions": ["mrkev:source"],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true
  }
}
