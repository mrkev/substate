{
  "private": true,
  "scripts": {
    "dev": "pnpm --filter site dev",
    "build": "nx run-many -t build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "test": "pnpm -r --filter '!old-state' run test",
    "coverage": "pnpm -r --filter '!old-state' run test --run --coverage --coverage.include='src/**' --coverage.include=index.ts",
    "tsc": "tsc -b"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "nx": "24.0.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "packageManager": "pnpm@10.34.7"
}
